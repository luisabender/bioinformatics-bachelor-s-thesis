	abstract = {The induction of alcohol fermentation in roots is a plant adaptive response to flooding stress and oxygen deprivation. Available transcriptomic data suggest that fermentation-related genes are also frequently induced in roots infected with gall forming pathogens, but the biological significance of this induction is unclear. In this study, we addressed the role of hypoxia responses in Arabidopsis roots during infection by the clubroot agent Plasmodiophora brassicae.},
	pages = {251},
	number = {1},
	journaltitle = {{BMC} Plant Biology},
