	author = {Gravot, Antoine and Richard, Gautier and Lime, Tanguy and Lemarié, Séverine and Jubault, Mélanie and Lariagon, Christine and Lemoine, Jocelyne and Vicente, Jorge and Robert-Seilaniantz, Alexandre and Holdsworth, Michael J. and Manzanares-Dauleux, Maria J.},
	urldate = {2025-03-03},
	date = {2016-11-11},
	keywords = {Arabidopsis, {ADH}1, Clubroot, {ERFVII}, Ethanol fermentation, Hypoxia, N-end rule pathway, {PDC}2, Plant gall disease, Plasmodiophora},
	file = {Full Text PDF:/Users/luisabender/Zotero/storage/NTPB5ATB/Gravot et al. - 2016 - Hypoxia response in Arabidopsis roots infected by Plasmodiophora brassicae supports the development.pdf:application/pdf;Snapshot:/Users/luisabender/Zotero/storage/TRXBXTBL/s12870-016-0941-y.html:text/html},
