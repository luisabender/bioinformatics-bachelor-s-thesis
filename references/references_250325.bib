@article{kong_pathogen-triggered_2023,
	title = {Pathogen-triggered changes in plant development: Virulence strategies or host defense mechanism?},
	volume = {14},
	issn = {1664-302X},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9975269/},
	doi = {10.3389/fmicb.2023.1122947},
	shorttitle = {Pathogen-triggered changes in plant development},
	abstract = {Plants, as sessile organisms, are constantly exposed to pathogens in nature. Plants rely on physical barriers, constitutive chemical defenses, and sophisticated inducible immunity to fight against pathogens. The output of these defense strategies is highly associated with host development and morphology. Successful pathogens utilize various virulence strategies to colonize, retrieve nutrients, and cause disease. In addition to the overall defense-growth balance, the host-pathogen interactions often lead to changes in the development of specific tissues/organs. In this review, we focus on recent advances in understanding the molecular mechanisms of pathogen-induced changes in plants’ development. We discuss that changes in host development could be a target of pathogen virulence strategies or an active defense strategy of plants. Current and ongoing research about how pathogens shape plant development to increase their virulence and causes diseases could give us novel views on plant disease control.},
	pages = {1122947},
	journaltitle = {Frontiers in Microbiology},
	shortjournal = {Front Microbiol},
	author = {Kong, Feng and Yang, Li},
	urldate = {2025-03-24},
	date = {2023-02-15},
	pmid = {36876088},
	pmcid = {PMC9975269},
	file = {PubMed Central Full Text PDF:/Users/luisabender/Zotero/storage/RSLQHXUK/Kong und Yang - 2023 - Pathogen-triggered changes in plant development Virulence strategies or host defense mechanism.pdf:application/pdf},
}

@article{sonah_computational_2016,
	title = {Computational Prediction of Effector Proteins in Fungi: Opportunities and Challenges},
	volume = {7},
	issn = {1664-462X},
	url = {https://www.frontiersin.org/journals/plant-science/articles/10.3389/fpls.2016.00126/full},
	doi = {10.3389/fpls.2016.00126},
	shorttitle = {Computational Prediction of Effector Proteins in Fungi},
	abstract = {{\textless}p{\textgreater}Effector proteins are mostly secretory proteins that stimulate plant infection by manipulating the host response. Identifying fungal effector proteins and understanding their function is of great importance in efforts to curb losses to plant diseases. Recent advances in high-throughput sequencing technologies have facilitated the availability of several fungal genomes and 1000s of transcriptomes. As a result, the growing amount of genomic information has provided great opportunities to identify putative effector proteins in different fungal species. There is little consensus over the annotation and functionality of effector proteins, and mostly small secretory proteins are considered as effector proteins, a concept that tends to overestimate the number of proteins involved in a plant–pathogen interaction. With the characterization of {\textless}italic{\textgreater}Avr{\textless}/italic{\textgreater} genes, criteria for computational prediction of effector proteins are becoming more efficient. There are 100s of tools available for the identification of conserved motifs, signature sequences and structural features in the proteins. Many pipelines and online servers, which combine several tools, are made available to perform genome-wide identification of effector proteins. In this review, available tools and pipelines, their strength and limitations for effective identification of fungal effector proteins are discussed. We also present an exhaustive list of classically secreted proteins along with their key conserved motifs found in 12 common plant pathogens (11 fungi and one oomycete) through an analytical pipeline.{\textless}/p{\textgreater}},
	journaltitle = {Frontiers in Plant Science},
	shortjournal = {Front. Plant Sci.},
	author = {Sonah, Humira and Deshmukh, Rupesh K. and Bélanger, Richard R.},
	urldate = {2025-03-24},
	date = {2016-02-12},
	note = {Publisher: Frontiers},
	keywords = {classification and prediction, computational tool and servers, Effector proteins, Fungal secretome, Host-Pathogen Interactions},
	file = {Full Text PDF:/Users/luisabender/Zotero/storage/95GZZ2XC/Sonah et al. - 2016 - Computational Prediction of Effector Proteins in Fungi Opportunities and Challenges.pdf:application/pdf},
}
