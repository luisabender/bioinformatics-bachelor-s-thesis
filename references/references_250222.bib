	pages = {15545--15550},
	file = {Volltext:/Users/luisabender/Zotero/storage/GTTQ83KQ/Subramanian et al. - 2005 - Gene set enrichment analysis A knowledge-based approach for interpreting genome-wide expression pro.pdf:application/pdf},
}

